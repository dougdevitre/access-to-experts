{
  "name": "@a2x/api",
  "version": "0.1.0",
  "description": "Access To Experts HTTP API — Express + TypeScript, AWS SDK v3, Anthropic integration.",
  "license": "Apache-2.0",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -b ../../packages/shared-types ../../packages/playbook-engine && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@a2x/playbook-engine": "workspace:*",
    "@a2x/shared-types": "workspace:*",
    "@anthropic-ai/sdk": "^0.30.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-ssm": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^7.2.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "stripe": "^17.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
