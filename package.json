{
  "name": "access-to-experts",
  "version": "0.1.0",
  "private": true,
  "description": "Access To Experts — structured expert-led guidance platform. Monorepo root.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "clean": "pnpm -r --if-present clean",
    "validate:playbooks": "tsx scripts/validate-playbook.ts schemas/examples/*.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.12.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.46.0"
  }
}
